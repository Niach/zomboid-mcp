#!/bin/bash
# Dev CLI for the Zomboid MCP bridge on the live server (docs/PROTOCOL.md, "Dev workflow").
# Reads ~/.config/zomboid-mcp/local.env (ZMCP_SSH, ZMCP_CONTAINER, ZMCP_VOLUME, ZMCP_LUA_DIR, ZMCP_DEV_LUA_MOUNT).
#
#   pz status                    bridge heartbeat (zmcp_status.json + age)
#   pz call <tool> [json-args]   call a bridge tool through the file protocol
#   pz eval "<lua>"              run_lua_server on the server
#   pz events [n]                last n bridge events
#   pz bench [n]                 round-trip latency of n pings
#   pz console "<cmd>"           raw server console command (players, servermsg, reloadlua ..., works while paused)
#   pz log [n]                   last n server console lines
#   pz load                      live-load Json.lua + Bridge.lua + Api/*.lua into the running server (no restart)
#   pz run file.lua              execute a local Lua file once on the server (via run_file)
#   pz push                      tools/deploy_server.sh: sync server Lua to the dev bind mount
#   pz reload [file]             console `reloadlua <file>` (default Bridge.lua; needs the ZomboidMCP mount)
#   pz poll                      make a paused server process pending requests once (console reloadlua)
#   pz bootstrap [file]          append (or refresh) tools/dev_bootstrap.lua in a loaded server file of the dev
#                                mount (default vapps/VappsGuardian.lua) so `pz load` / polling work before
#                                the ZomboidMCP mount exists
#   pz legacy cmd|events ...     old vapps Guardian command file (heal|cure|god ... while it still runs)
# Env: ZMCP_POLL_FILE (default ZomboidMCP/ZMCPPoll.lua; VappsGuardian.lua until the mount exists) is the
# loaded file whose `reloadlua` polls the bridge while the server is paused; PZ_TIMEOUT (s).
set -o pipefail
[ -f ~/.config/zomboid-mcp/local.env ] && . ~/.config/zomboid-mcp/local.env
H=$ZMCP_SSH
C=$ZMCP_CONTAINER
V=$ZMCP_VOLUME
L=${ZMCP_LUA_DIR:-$V/Lua}
M=${ZMCP_DEV_LUA_MOUNT:-/opt/zomboid-lua}
DIR=$(dirname "$(readlink -f "$0")")
ROOT=$(dirname "$DIR")
MOD=$ROOT/mod/Contents/mods/ZomboidMCP/42/media/lua
CLIENT="python3 $DIR/zmcp_client.py"
POLL_FILE=${ZMCP_POLL_FILE:-ZomboidMCP/ZMCPPoll.lua}
# host-side command that makes a paused server run one bridge poll (see docs/PROTOCOL.md)
[ -n "$C" ] && export ZMCP_POLL_CMD=${ZMCP_POLL_CMD:-"echo 'reloadlua $POLL_FILE' | docker exec -i $C sh -c 'cat > /tmp/pz-console'"}
SSH="ssh -o BatchMode=yes -o ConnectTimeout=10 -o ControlMaster=auto -o ControlPath=$HOME/.ssh/zmcp-%C -o ControlPersist=600"
export ZMCP_SSH ZMCP_LUA_DIR=$L

need_env() { [ -n "$H" ] && [ -n "$L" ] || { echo "ZMCP_SSH / ZMCP_LUA_DIR not set (see docs/local.env.example)" >&2; exit 2; }; }

# is the bridge answering? (status younger than 5 s)
bridge_alive() {
  local t now
  t=$($SSH $H "sed -n 's/.*\"t\":\([0-9]*\).*/\1/p' $L/zmcp_status.json 2>/dev/null")
  now=$(date +%s)
  [ -n "$t" ] && [ $((now - t)) -lt 5 ]
}

console() {
  printf '%s\n' "$*" | $SSH $H "N=\$(wc -l < $V/server-console.txt); docker exec -i $C sh -c 'cat > /tmp/pz-console'; sleep ${PZ_CONSOLE_WAIT:-2}; tail -n +\$N $V/server-console.txt | grep -vE 'AnimState|Property Name|Ragdoll|Saving|SaveAll' | cut -c1-240"
}

case "$1" in
  status) need_env; $CLIENT status ;;
  call) need_env; shift; $CLIENT --timeout "${PZ_TIMEOUT:-10}" call "$@" ;;
  eval) need_env; shift; $CLIENT --timeout "${PZ_TIMEOUT:-10}" eval "$*" ;;
  events) need_env; $CLIENT events "${2:-20}" ;;
  bench) need_env; $CLIENT bench "${2:-10}" ;;
  console) need_env; shift; console "$@" ;;
  log) need_env; $SSH $H "tail -n ${2:-40} $V/server-console.txt | cut -c1-240" ;;
  load)
    need_env
    # upload every server file as zmcp_src_<name>.lua plus a loader, then run the loader on the live server
    files=("$MOD/shared/ZomboidMCP/Json.lua" "$MOD/shared/ZomboidMCP/CollisionSprites.lua"
           "$MOD/server/ZomboidMCP/Bridge.lua" "$MOD/server/ZomboidMCP/Api/Common.lua")
    for f in "$MOD"/server/ZomboidMCP/Api/*.lua; do [ -f "$f" ] && [ "$(basename "$f")" != Common.lua ] && files+=("$f"); done
    names=()
    for f in "${files[@]}"; do
      n="zmcp_src_$(basename "$f")"; names+=("$n")
      $SSH $H "umask 022; cat > $L/$n.tmp && mv -f $L/$n.tmp $L/$n" < "$f" || { echo "upload $f failed" >&2; exit 1; }
    done
    stamp=$(date +%s)-$$
    {
      echo "-- zmcp_boot $stamp"
      echo "-- generated by tools/pz load: run the uploaded server files in order, each as its own chunk"
      echo "local STAMP = \"$stamp\""
      printf 'local files = {'; for n in "${names[@]}"; do printf ' "%s",' "$n"; done; echo ' }'
      cat <<'EOF'
local function readFile(name)
    local ok, r = pcall(getFileReader, name, false)
    if not ok or not r then return nil end
    local t, l = {}, r:readLine()
    while l do t[#t + 1] = l; l = r:readLine() end
    r:close()
    return table.concat(t, "\n")
end
local done = {}
for _, f in ipairs(files) do
    local text = readFile(f)
    if not text then error("missing " .. f) end
    local fn, err = loadstring(text, "=" .. f)
    if not fn then error("compile " .. f .. ": " .. tostring(err)) end
    local ok, e = pcall(fn)
    if not ok then error("run " .. f .. ": " .. tostring(e)) end
    done[#done + 1] = f
end
if ZMCP then ZMCP.bootStamp = STAMP end
return "loaded " .. table.concat(done, ", ")
EOF
    } | $SSH $H "umask 022; cat > $L/zmcp_boot.lua.tmp && mv -f $L/zmcp_boot.lua.tmp $L/zmcp_boot.lua"
    echo "uploaded: ${names[*]} + zmcp_boot.lua"
    if bridge_alive; then
      echo "bridge alive: loading through run_file"
      $CLIENT --timeout 20 call run_file '{"file":"zmcp_boot.lua"}'
    else
      echo "bridge not alive: reloadlua $POLL_FILE (dev bootstrap) through the console"
      PZ_CONSOLE_WAIT=4 console "reloadlua $POLL_FILE" | grep -E 'ZomboidMCP|reloadlua|rror' || true
    fi
    ;;
  run) need_env; [ -f "$2" ] || { echo "usage: pz run file.lua" >&2; exit 2; }
    $SSH $H "umask 022; cat > $L/zmcp_run.lua.tmp && mv -f $L/zmcp_run.lua.tmp $L/zmcp_run.lua" < "$2" && $CLIENT --timeout "${PZ_TIMEOUT:-20}" call run_file '{"file":"zmcp_run.lua"}' ;;
  push) shift; "$DIR/deploy_server.sh" "$@" ;;
  reload) need_env; console "reloadlua ${2:-ZomboidMCP/Bridge.lua}" ;;
  poll) need_env; PZ_CONSOLE_WAIT=1 console "reloadlua $POLL_FILE" | grep -E 'ZomboidMCP|reloadlua|rror' || true ;;
  bootstrap)
    need_env
    target=$M/${2:-vapps/VappsGuardian.lua}
    # keep a pristine copy, drop a previous bootstrap block, append the current one
    $SSH $H "cp -n $target $target.orig 2>/dev/null; sed -i '/^-- >>> ZomboidMCP dev bootstrap/,/^-- <<< ZomboidMCP dev bootstrap/d' $target && cat >> $target" < "$DIR/dev_bootstrap.lua" \
      && echo "dev bootstrap installed in $target (pristine copy: $target.orig). Next: pz load" ;;
  legacy) need_env; shift
    case "$1" in
      cmd) shift; printf '%s\n' "$*" | $SSH $H "cat >> $L/vapps_cmd.txt"; sleep 3; $SSH $H "tail -3 $L/vapps_events.log" ;;
      events) $SSH $H "tail -${2:-15} $L/vapps_events.log" ;;
      status) $SSH $H "cat $L/vapps_status.json" ;;
      *) echo "pz legacy cmd <guardian cmd> | events [n] | status" >&2; exit 2 ;;
    esac ;;
  *) sed -n '5,20p' "$0" ;;
esac
