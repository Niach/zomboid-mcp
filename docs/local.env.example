# Copy to ~/.config/zomboid-mcp/local.env and fill in (never commit the real file)
ZMCP_SSH=root@your-server
ZMCP_CONTAINER=your-zomboid-container
ZMCP_COOLIFY_SERVICE=
ZMCP_VOLUME=/var/lib/docker/volumes/<zomboid-data>/_data
ZMCP_LUA_DIR=$ZMCP_VOLUME/Lua
ZMCP_DEV_LUA_MOUNT=/opt/zomboid-lua
ZMCP_STEAMCMD=~/steamcmd/steamcmd.sh
ZMCP_STEAMCMD_HOME=~/steamcmd/home
ZMCP_STEAM_USER=
ZMCP_WORKSHOP_ID=
# Loaded server Lua file whose `reloadlua` polls the bridge while the server is paused (docs/PROTOCOL.md).
# Until the ZomboidMCP bind mount exists this is the bootstrapped vapps Guardian; afterwards ZomboidMCP/ZMCPPoll.lua.
ZMCP_POLL_FILE=VappsGuardian.lua
